{
    "name": "noffprod/iar",
    "description": "Portable PHP image resizer with transparent caching (WebP/AVIF, crop, smart PNG)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-gd": "*",
        "intervention/image": "^3.11"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.64",
        "infection/infection": "^0.27"
    },
    "suggest": {
        "ext-exif": "Needed to honour EXIF orientation of JPEG photos (otherwise rotation is silently skipped)",
        "ext-imagick": "Needed to rasterize SVG sources into raster formats"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test-portable": "php tests/run.php",
        "test-integration": "php tools/integration.php run",
        "test-all": [
            "@test-portable",
            "@test-integration"
        ],
        "stan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "coverage": "phpunit --testsuite unit --coverage-clover clover.xml",
        "coverage-gate": "php tools/coverage-gate.php clover.xml",
        "coverage-portable": [
            "php tools/coverage-portable.php build",
            "php tests/coverage-run.php",
            "php tools/integration.php run",
            "php tools/coverage-portable.php report 100"
        ],
        "mutation": "infection --threads=2 --min-msi=90 --min-covered-msi=90"
    },
    "config": {
        "allow-plugins": {
            "intervention/image": true,
            "infection/extension-installer": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "scripts-descriptions": {
        "test": "Юнит-тесты через PHPUnit",
        "test-portable": "Юнит-тесты без composer и PHPUnit",
        "test-integration": "Интеграционные HTTP-сценарии на встроенном сервере PHP",
        "coverage-portable": "Покрытие строк без Xdebug/PCOV и порог 100%",
        "coverage-gate": "Порог 100% по clover-отчёту PHPUnit"
    }
}
