# IAR — Image Auto Resizer

# Зависимости Composer (восстанавливаются через composer install)
/vendor/
/composer.phar

# Кешированные миниатюры (генерируются автоматически, в git не нужны)
/cache/*
!/cache/.gitkeep

# Отладочный лог (выключен по умолчанию, в git не попадает)
/log/*
!/log/.gitkeep

# Локальное переопределение конфига для конкретного окружения
/config.local.php

# Артефакты тестов и анализа
/.cov/
/.probe/
/.phpunit.cache/
/.php-cs-fixer.cache
/clover.xml
/coverage/
/infection.log
/summary.log
/per-mutator.md

# Внутренняя документация и черновики
/.doc/
/audit.md

# Временные и системные файлы
*.DS_Store
Thumbs.db
