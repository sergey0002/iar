# ============================================================
# IAR — Image Auto Resizer
# Правила относительные: папку можно переименовывать и переносить.
# ============================================================

# Запрет листинга каталогов (аудит S-05/DEP-01)
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Dotfiles (.git, .env, .htaccess и т.п.) наружу не отдаём (DEP-03)
    RewriteRule (^|/)\. - [F]

    # Служебные каталоги закрыты. cache/ намеренно открыт —
    # на него ведёт редирект redirect_to_cache.
    RewriteRule ^(log|vendor|src|docs|tests|tools)(/|$) - [F]

    # Существующий файл кеша отдаёт сам Apache (без PHP)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^cache/ - [L]

    # Изображения — через index.php.
    # [B] экранирует backreference: имена с '&' больше не ломаются (B-12).
    RewriteCond $1 !^cache/
    RewriteRule ^(.*)\.(jpg|jpeg|png|gif|webp|avif|svg)$ index.php?name=$1.$2 [L,QSA,NC,B]
</IfModule>

# ============================================================
# Из PHP-файлов доступен только index.php
# ============================================================
<FilesMatch "\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<Files "index.php">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</Files>

# Служебные файлы конфигурации и сборки.
# aliases.json закрыт намеренно: он раскрывает реальные каталоги,
# которые псевдонимы как раз и прячут.
<FilesMatch "^(config\.php|aliases\.json|composer\.(json|lock|phar)|phpunit\.xml(\.dist)?|infection\.json(\.dist)?|\.editorconfig|\.gitignore|\.php-cs-fixer(\.dist)?\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Логи отладки не должны скачиваться по HTTP (аудит L-02)
<FilesMatch "\.log$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ============================================================
# Заголовки безопасности при прямой отдаче Apache.
# В PHP-пути те же заголовки ставит App\Application.
# ============================================================
# Файлы кеша версионированы именем: при изменении оригинала меняется
# mtime в имени, значит меняется и URL. Поэтому их можно кешировать
# в браузере «навсегда» — браузер всё равно получит новый URL, потому
# что сам редирект (/iar/photo.jpg?w=...) отдаётся с no-cache.
# ВАЖНО: правило безопасно при cache_key_config_hash => true (дефолт).
SetEnvIfNoCase Request_URI "(^|/)cache/" IAR_CACHE_FILE=1

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"

    # Мгновенные повторные просмотры: файл берётся из кеша браузера,
    # запрос к серверу не уходит вовсе.
    Header always set Cache-Control "public, max-age=31536000, immutable" env=IAR_CACHE_FILE

    # SVG может содержать скрипты — запрещаем выполнение (аудит S-01)
    <FilesMatch "\.svg$">
        Header always set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
    </FilesMatch>
</IfModule>
